{
  "manifest_version": 3,
  "name": "AI Smart Tab Manager",
  "version": "0.2.0",
  "description": "Organize your open tabs into persistent bookmark folders with an AI chat assistant. Bring your own Anthropic API key.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "bookmarks", "storage", "sidePanel", "favicon", "alarms", "unlimitedStorage", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AI Smart Tab Manager"
  }
}
