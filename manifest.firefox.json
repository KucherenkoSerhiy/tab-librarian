{
  "manifest_version": 3,
  "name": "Tab Librarian",
  "version": "0.3.0",
  "description": "Your AI librarian for tabs: files 100+ open tabs into a tidy bookmark library you approve, so you can close them without fear. BYOK.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "bookmarks", "storage", "alarms", "unlimitedStorage", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Tab Librarian",
    "default_icon": "icons/icon48.png"
  },
  "action": {
    "default_title": "Tab Librarian"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-librarian@kucherenkoserhiy.dev",
      "strict_min_version": "121.0"
    }
  }
}
