{
  "manifest_version": 3,
  "name": "Tab Librarian",
  "version": "1.0.0",
  "description": "Your AI librarian for tabs: files 100+ open tabs into a tidy bookmark library you approve, so you can close them without fear. BYOK.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "bookmarks", "storage", "sidePanel", "favicon", "alarms", "unlimitedStorage", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tab Librarian"
  }
}
