{
  "manifest_version": 3,
  "name": "AI Smart Tab Manager",
  "version": "0.2.0",
  "description": "Organize your open tabs into persistent bookmark folders with an AI chat assistant. Bring your own API key.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "bookmarks", "storage", "alarms", "unlimitedStorage", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "AI Smart Tab Manager",
    "default_icon": "icons/icon48.png"
  },
  "action": {
    "default_title": "AI Smart Tab Manager"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-smart-tab-manager@kucherenkoserhiy.dev",
      "strict_min_version": "121.0"
    }
  }
}
